{
  "name": "essays-thoughts-letters",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:assets && wrangler dev",
    "deploy": "npm run build:assets && wrangler deploy",
    "build:assets": "node scripts/build-assets.js",
    "build:corpus": "node scripts/buildCorpus.js",
    "update-toc": "node scripts/updateToc.js",
    "db:migrate:local": "wrangler d1 migrations apply essays-thoughts-letters --local",
    "db:migrate:remote": "wrangler d1 migrations apply essays-thoughts-letters --remote",
    "db:seed:local": "node scripts/seed.js --local",
    "db:seed:remote": "node scripts/seed.js --remote",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.0",
    "markdown-it-footnote": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "typescript": "^5.6.3",
    "wrangler": "^4.93.0"
  }
}
